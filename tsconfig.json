{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": ["apps/web/**/*.ts", "apps/web/**/*.tsx", "packages/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "apps/web/.next", "packages/db/prisma"]
}
