# Database (Vercel Postgres, Neon, or local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siteyonetim?schema=public"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Optional: Upstash Redis (Vercel integration). Without these, cache is no-op in dev.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
