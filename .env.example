# Local development — Docker Postgres (docker compose up -d, port 5433).
# Production: Vercel Environment Variables (Neon). Never commit prod DATABASE_URL here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/siteyonetim?schema=public"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

CRON_SECRET=""

# Optional: absolute base URL for links in system e-mails (e.g. https://app.example.com)
APP_URL=""

# Optional: Upstash Redis (Vercel integration). Without these, cache is no-op in dev.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# WhatsApp Cloud API (Meta). Without WHATSAPP_ACCESS_TOKEN, outbox uses console logging.
WHATSAPP_ACCESS_TOKEN=""
# Default phone number ID when property profile leaves phoneNumberId empty
WHATSAPP_PHONE_NUMBER_ID=""
# Meta template: name siteyonetim_duyuru, language tr, body with {{1}} title and {{2}} message text

# E-posta (Resend veya SendGrid). Sağlayıcı yoksa outbox konsola yazar.
EMAIL_PROVIDER="resend"
EMAIL_FROM="Site Yönetim <noreply@yourdomain.com>"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# SMS (Twilio veya Netgsm). Sağlayıcı yoksa outbox konsola yazar.
SMS_PROVIDER="netgsm"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_MSGHEADER=""

# Pilot: paylaşımlı şema varsayılan; ayrı DB izolasyonu UI FAZ 2 (ORG_ADMIN + true)
TENANT_DATABASE_ISOLATION_ENABLED="false"

# Opsiyonel: landing sayfası önizlemesinde gösterilecek site (boşsa en güncel site kullanılır)
HOME_SHOWCASE_PROPERTY_ID=""

# Platform süper yöneticisi (DEVELOPMENT_RULES.md §33). Şifre repoda tutulmaz; seed yalnızca SUPER_ADMIN_PASSWORD
# tanımlıysa hesabı oluşturur/günceller. Production: Vercel/env secret veya güvenli ops kanalı.
# SUPER_ADMIN_EMAIL="bora.bayraktar@hotmail.com"
SUPER_ADMIN_PASSWORD=""
# SUPER_ADMIN_NAME="Platform Süper Admin"
