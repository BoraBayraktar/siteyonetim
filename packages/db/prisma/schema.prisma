generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyKind {
  APARTMAN
  APARTMAN_SITE
}

enum AdminNavProfile {
  DAILY
  FULL
  READONLY
}

enum OrganizationRole {
  ORG_ADMIN
  PROPERTY_MANAGER
  ACCOUNTANT
  BOARD_MEMBER
  AUDITOR
  STAFF
}

enum PropertyIsolationMode {
  SHARED_SCHEMA
  DEDICATED_DATABASE
}

enum PropertyTenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

enum PortalAuthMode {
  EMAIL
  UNIT_CREDENTIAL
  BOTH
}

enum PropertyAccessRole {
  PROPERTY_ADMIN
  PROPERTY_MANAGER
  PROPERTY_ACCOUNTANT
  PROPERTY_AUDITOR
  PROPERTY_BOARD_MEMBER
  PROPERTY_STAFF
  SECURITY
  MAINTENANCE
}

enum PartyType {
  PERSON
  COMPANY
}

enum OccupancyRole {
  OWNER
  TENANT
}

enum FinancePeriodStatus {
  OPEN
  CLOSED
}

enum FinanceCategoryType {
  INCOME
  EXPENSE
}

enum FinanceAccountKind {
  PARTY
  SUPPLIER
  STAFF
  GENERAL
}

enum LedgerEntryType {
  INCOME
  EXPENSE
}

enum CashboxMovementDirection {
  IN
  OUT
}

enum StaffEmploymentStatus {
  ACTIVE
  PASSIVE
}

enum StaffMovementType {
  SALARY_ACCRUAL
  ADVANCE
  PAYMENT
  ADVANCE_OFFSET
  DEDUCTION
  BONUS
  MANUAL_ADJUSTMENT
}

enum PaymentChannel {
  MANUAL
  ONLINE
  BANK
}

enum PaymentProvider {
  IYZICO
}

enum PaymentIntentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum DueCalculationMode {
  FIXED
  AREA_M2
  SHARE_RATIO
  ALLOCATED_BILL
  METER_CONSUMPTION
  METER_ALLOCATED_BILL
  SUPPLIER_LATE_FEE_BILL
}

enum DueAccrualLineKind {
  STANDARD
  LATE_FEE
  SUPPLIER_LATE_FEE
}

enum SupplierLateFeeAllocationMode {
  ALL_UNITS_BY_SHARE
  ALL_UNITS_EQUAL
  DELINQUENT_BY_DEBT_RATIO
  DELINQUENT_EQUAL
}

enum MeterKind {
  HOT_WATER
  COLD_WATER
  HEATING
  GAS
}

enum HeatingSystemType {
  NONE
  INDIVIDUAL_GAS
  CENTRAL_GAS
  CENTRAL_OTHER
  DISTRICT_HEATING
}

enum HotWaterSystemType {
  NONE
  INDIVIDUAL
  CENTRAL_INDIVIDUAL_METER
  CENTRAL_SHARED
}

enum LateFeeRateKind {
  CONTRACTUAL
  LEGAL_TCMB
}

enum JobType {
  LATE_FEE_MONTHLY
  DUE_ACCRUAL_MONTHLY
  ACCRUAL_DRAFT_REMINDER
  METER_READING_REMINDER
  REPORT_EXPORT
  AUDITOR_QUARTER_REMINDER
  BANK_STATEMENT_SYNC
}

enum ReportExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ReportExportFormat {
  CSV
  XLSX
  PDF
  ZIP
}

enum JobRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum DueAccrualStatus {
  DRAFT
  POSTED
}

enum DueLineStatus {
  OPEN
  PARTIAL
  PAID
}

enum AnnouncementAudience {
  PROPERTY_ALL
  BLOCK
  UNITS
}

enum AnnouncementBodyFormat {
  PLAIN
  HTML
}

enum AnnouncementWorkflowStatus {
  DRAFT
  PUBLISHED
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum IncidentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum IncidentCategory {
  ELEVATOR
  PLUMBING
  ELECTRICAL
  COMMON_AREA
  SECURITY
  OTHER
}

enum OutboxChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

enum DocumentCategory {
  CONTRACT
  BOARD_MINUTES
  INVOICE_COPY
  AUDITOR_REPORT
  OTHER
}

enum AuditorReportPeriod {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
}

enum AuditorReportStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum AuditorDischargeRecommendation {
  RECOMMEND
  NOT_RECOMMEND
  CONDITIONAL
}

enum BankStatementMatchStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum BankStatementImportSource {
  MANUAL_CSV
  API_WEBHOOK
  API_REST_POLL
}

enum BankSyncProviderKind {
  WEBHOOK_PUSH
  GENERIC_REST_POLL
}

enum GeneralAssemblyMeetingType {
  ORDINARY
  EXTRAORDINARY
}

enum AssemblyNoticeMethod {
  POST
  COURIER
  EMAIL
  HAND_DELIVERY
  OTHER
}

enum AssemblyAttendanceKind {
  PRESENT
  PROXY
  ABSENT
}

enum DocumentVisibility {
  ADMIN_ONLY
  PORTAL_SHARED
  UNIT_SPECIFIC
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deleted         Boolean   @default(false)
  deletedDate     DateTime?
  deletedUserId   String?

  requireTwoFactor Boolean @default(false)

  users      UserOrganization[]
  properties Property[]
  parties    Party[]
  auditLogs  AuditLog[]
  financePeriods   FinancePeriod[]
  financeCategories FinanceCategory[]
  financeAccounts  FinanceAccount[]
  staffProfiles    PropertyStaffProfile[]
  staffMovements   StaffAccountMovement[]
  cashboxes        Cashbox[]
  ledgerEntries    LedgerEntry[]
  dueDefinitions   DueDefinition[]
  dueAccrualRuns   DueAccrualRun[]
  payments         Payment[]
  announcements    Announcement[]
  outboxMessages   OutboxMessage[]
  documents        Document[]
  incidents        Incident[]
  bankStatementImports BankStatementImport[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Platform süper yöneticisi; org kullanıcı listesinde görünmez, RBAC kısıtlanamaz.
  isSuperAdmin Boolean  @default(false)

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  totpBackupCodes Json?

  organizations      UserOrganization[]
  propertyAccess     UserPropertyAccess[]
  passwordResetTokens PasswordResetToken[]
  auditLogs          AuditLog[]
  portalParty        Party?           @relation("PortalUser")
  announcementReads  AnnouncementRead[]
  uploadedDocuments  Document[]
  createdAnnouncements Announcement[] @relation("AnnouncementCreatedBy")
  reportedIncidents    Incident[]       @relation("IncidentReportedBy")
  uiPreferences        UserUiPreference[]
}

model UserUiPreference {
  id                         String           @id @default(cuid())
  userId                     String
  organizationId             String
  adminOnboardingCompletedAt DateTime?
  adminOnboardingStep        Int?
  navProfile                 AdminNavProfile?
  dismissedHints             Json?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId, deleted])
}

model UserOrganization {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(PROPERTY_MANAGER)
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deleted])
  @@index([expiresAt])
}

model Property {
  id             String       @id @default(cuid())
  organizationId String
  kind           PropertyKind @default(APARTMAN)
  name           String
  address        String?
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  blocks       Block[]
  units        Unit[]
  financePeriods    FinancePeriod[]
  financeCategories FinanceCategory[]
  financeAccounts   FinanceAccount[]
  staffProfiles     PropertyStaffProfile[]
  staffMovements    StaffAccountMovement[]
  cashboxes         Cashbox[]
  ledgerEntries     LedgerEntry[]
  dueDefinitions    DueDefinition[]
  dueAccrualRuns    DueAccrualRun[]
  payments          Payment[]
  announcements     Announcement[]
  outboxMessages    OutboxMessage[]
  documents         Document[]
  utilityProfile    PropertyUtilityProfile?
  whatsAppProfile   PropertyWhatsAppProfile?
  unitMeters        UnitMeter[]
  lateFeePolicy     DueLateFeePolicy?
  reportExports     ReportExport[]
  operatingBudgets  OperatingBudget[]
  tenant            PropertyTenant?
  userAccess        UserPropertyAccess[]
  portalCredentials PortalUnitCredential[]
  auditorAssignments AuditorAssignment[]
  auditorReports    AuditorReport[]
  bankStatementImports BankStatementImport[]
  bankWebhookProfile PropertyBankWebhookProfile?
  paymentProfile         PropertyPaymentProfile?
  paymentIntents         PaymentIntent[]
  generalAssemblyMeetings GeneralAssemblyMeeting[]
  incidents               Incident[]
  staffOpsProfile         PropertyStaffOpsProfile?

  @@index([organizationId, deleted])
}

model PropertyTenant {
  id                   String                @id @default(cuid())
  propertyId           String                @unique
  organizationId       String
  portalCode           String                @unique
  isolationMode        PropertyIsolationMode @default(SHARED_SCHEMA)
  neonProjectId        String?
  neonBranchId         String?
  databaseUrlSecretKey String?
  portalAuthMode       PortalAuthMode        @default(BOTH)
  status               PropertyTenantStatus  @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  property         Property               @relation(fields: [propertyId], references: [id])
  portalSettings   PropertyPortalSettings?
  unitCredentials  PortalUnitCredential[]

  @@index([organizationId, deleted])
  @@index([portalCode, deleted])
}

model PropertyPortalSettings {
  id                      String   @id @default(cuid())
  propertyTenantId        String   @unique
  showIncomeExpenseReport Boolean  @default(false)
  showMemberDebtSummary   Boolean  @default(false)
  allowOnlinePayment      Boolean  @default(false)
  showAnnouncements       Boolean  @default(true)
  showDocuments           Boolean  @default(true)
  showStatement           Boolean  @default(true)
  showIncidents           Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  propertyTenant PropertyTenant @relation(fields: [propertyTenantId], references: [id])
}

model UserPropertyAccess {
  id             String             @id @default(cuid())
  userId         String
  organizationId String
  propertyId     String
  role           PropertyAccessRole
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@unique([userId, propertyId])
  @@index([organizationId, propertyId, deleted])
  @@index([userId, deleted])
}

model PortalUnitCredential {
  id               String    @id @default(cuid())
  propertyTenantId String
  propertyId       String
  unitId           String    @unique
  passwordHash     String
  active           Boolean   @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  propertyTenant PropertyTenant @relation(fields: [propertyTenantId], references: [id])
  property       Property       @relation(fields: [propertyId], references: [id])
  unit           Unit           @relation(fields: [unitId], references: [id])
  incidents      Incident[]

  @@index([propertyId, deleted])
  @@index([propertyTenantId, deleted])
}

model OperatingBudget {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  year           Int
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  property Property              @relation(fields: [propertyId], references: [id])
  lines    OperatingBudgetLine[]

  @@unique([propertyId, year])
  @@index([organizationId, propertyId, deleted])
}

model OperatingBudgetLine {
  id            String  @id @default(cuid())
  budgetId      String
  categoryId    String
  plannedAmount Decimal @db.Decimal(14, 2)

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  budget   OperatingBudget @relation(fields: [budgetId], references: [id])
  category FinanceCategory @relation(fields: [categoryId], references: [id])

  @@unique([budgetId, categoryId])
  @@index([budgetId, deleted])
}

model Block {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  property Property @relation(fields: [propertyId], references: [id])
  units    Unit[]
  announcements Announcement[]

  @@unique([propertyId, name])
  @@index([propertyId, deleted])
}

model Unit {
  id         String   @id @default(cuid())
  propertyId String
  blockId    String?
  code       String
  floor      Int?
  areaM2     Decimal? @db.Decimal(10, 2)
  shareRatio Decimal? @db.Decimal(10, 6)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  property    Property     @relation(fields: [propertyId], references: [id])
  block       Block?       @relation(fields: [blockId], references: [id])
  occupancies Occupancy[]
  dueAccrualLines DueAccrualLine[]
  announcementTargets AnnouncementUnitTarget[]
  documentTargets     DocumentUnitTarget[]
  unitMeters            UnitMeter[]
  portalCredential      PortalUnitCredential?
  assemblyAttendances   AssemblyAttendance[]
  incidents             Incident[]

  @@unique([propertyId, code])
  @@index([propertyId, deleted])
  @@index([blockId])
}

model Party {
  id             String    @id @default(cuid())
  organizationId String
  type           PartyType @default(PERSON)
  displayName    String
  email                 String?
  phone                 String?
  communicationConsent  Boolean   @default(false)
  portalUserId          String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  portalUser   User?        @relation("PortalUser", fields: [portalUserId], references: [id])
  occupancies  Occupancy[]
  financeAccounts FinanceAccount[]
  staffProfiles   PropertyStaffProfile[]
  dueAccrualLines DueAccrualLine[]
  payments        Payment[]
  paymentIntents  PaymentIntent[]

  @@index([organizationId, deleted])
  @@index([email])
}

model Occupancy {
  id        String         @id @default(cuid())
  unitId    String
  partyId   String
  role      OccupancyRole
  startDate DateTime       @default(now())
  endDate   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  unit  Unit  @relation(fields: [unitId], references: [id])
  party Party @relation(fields: [partyId], references: [id])

  @@index([unitId, deleted])
  @@index([partyId, deleted])
  @@index([unitId, role, endDate])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model FinancePeriod {
  id             String               @id @default(cuid())
  organizationId String
  propertyId     String
  year           Int
  month          Int
  status         FinancePeriodStatus    @default(OPEN)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  ledgerEntries LedgerEntry[]
  dueAccrualRuns DueAccrualRun[]

  @@unique([propertyId, year, month])
  @@index([organizationId, propertyId, status])
}

model FinanceCategory {
  id             String              @id @default(cuid())
  organizationId String
  propertyId     String
  name           String
  type           FinanceCategoryType
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  ledgerEntries LedgerEntry[]
  operatingBudgetLines OperatingBudgetLine[]

  @@unique([propertyId, name, type])
  @@index([propertyId, deleted])
}

model FinanceAccount {
  id             String             @id @default(cuid())
  organizationId String
  propertyId     String
  partyId        String?
  code           String
  name           String
  kind           FinanceAccountKind @default(GENERAL)
  balance        Decimal            @default(0) @db.Decimal(14, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  party        Party?       @relation(fields: [partyId], references: [id])
  ledgerEntries LedgerEntry[]
  dueAccrualLines DueAccrualLine[]
  payments      Payment[]
  staffProfiles PropertyStaffProfile[]
  staffMovements StaffAccountMovement[]

  @@unique([propertyId, code])
  @@index([propertyId, deleted])
  @@index([partyId])
}

model PropertyStaffProfile {
  id               String                @id @default(cuid())
  organizationId   String
  propertyId       String
  partyId          String
  financeAccountId String                @unique
  staffNo          String?
  title            String?
  department       String?
  employmentStartDate DateTime?
  employmentEndDate   DateTime?
  status           StaffEmploymentStatus @default(ACTIVE)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization   Organization          @relation(fields: [organizationId], references: [id])
  property       Property              @relation(fields: [propertyId], references: [id])
  party          Party                 @relation(fields: [partyId], references: [id])
  financeAccount FinanceAccount        @relation(fields: [financeAccountId], references: [id])
  movements      StaffAccountMovement[]

  @@unique([propertyId, partyId, deleted])
  @@unique([propertyId, staffNo])
  @@index([organizationId, propertyId, status, deleted])
  @@index([partyId, deleted])
}

model StaffAccountMovement {
  id               String            @id @default(cuid())
  organizationId   String
  propertyId       String
  staffProfileId   String
  financeAccountId String
  ledgerEntryId    String?
  movementType     StaffMovementType
  amount           Decimal           @db.Decimal(14, 2)
  movementDate     DateTime          @default(now())
  periodYear       Int
  periodMonth      Int
  documentNo       String?
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization   Organization        @relation(fields: [organizationId], references: [id])
  property       Property            @relation(fields: [propertyId], references: [id])
  staffProfile   PropertyStaffProfile @relation(fields: [staffProfileId], references: [id])
  financeAccount FinanceAccount      @relation(fields: [financeAccountId], references: [id])
  ledgerEntry    LedgerEntry?        @relation(fields: [ledgerEntryId], references: [id])

  @@index([propertyId, movementDate])
  @@index([staffProfileId, movementDate])
  @@index([financeAccountId])
  @@index([ledgerEntryId])
  @@index([organizationId, deleted])
}

model Cashbox {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  name           String
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization Organization      @relation(fields: [organizationId], references: [id])
  property     Property          @relation(fields: [propertyId], references: [id])
  movements    CashboxMovement[]
  ledgerEntries LedgerEntry[]
  payments     Payment[]
  bankStatementImports BankStatementImport[]
  bankWebhookProfiles PropertyBankWebhookProfile[]
  paymentProfiles     PropertyPaymentProfile[]

  @@unique([propertyId, name])
  @@index([propertyId, deleted])
}

model CashboxMovement {
  id           String                   @id @default(cuid())
  cashboxId    String
  direction    CashboxMovementDirection
  amount       Decimal                  @db.Decimal(14, 2)
  ledgerEntryId String?                 @unique
  description  String?
  movementDate DateTime                 @default(now())
  createdAt    DateTime                 @default(now())

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  cashbox     Cashbox      @relation(fields: [cashboxId], references: [id])
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  bankStatementMatches BankStatementLine[] @relation("CashboxMovementBankMatch")

  @@index([cashboxId, movementDate])
}

model LedgerEntry {
  id              String          @id @default(cuid())
  organizationId  String
  propertyId      String
  financePeriodId String
  entryType       LedgerEntryType
  categoryId      String
  financeAccountId String?
  cashboxId       String?
  amount          Decimal         @db.Decimal(14, 2)
  documentNo      String?
  description     String?
  entryDate       DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  organization  Organization   @relation(fields: [organizationId], references: [id])
  property      Property       @relation(fields: [propertyId], references: [id])
  financePeriod FinancePeriod  @relation(fields: [financePeriodId], references: [id])
  category      FinanceCategory @relation(fields: [categoryId], references: [id])
  financeAccount FinanceAccount? @relation(fields: [financeAccountId], references: [id])
  cashbox       Cashbox?        @relation(fields: [cashboxId], references: [id])
  cashboxMovement CashboxMovement?
  staffMovements StaffAccountMovement[]
  linkedIncident  Incident?

  @@index([propertyId, entryDate])
  @@index([financePeriodId])
  @@index([organizationId, deleted])
}

model DueDefinition {
  id              String             @id @default(cuid())
  organizationId  String
  propertyId      String
  name            String
  calculationMode DueCalculationMode @default(FIXED)
  fixedAmount     Decimal?           @db.Decimal(14, 2)
  ratePerM2       Decimal?           @db.Decimal(14, 4)
  meterKind       MeterKind?
  supplierLateFeeAllocationMode SupplierLateFeeAllocationMode?
  isSystem        Boolean            @default(false)
  autoAccrualMonthly Boolean         @default(false)
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  deleted       Boolean   @default(false)
  deletedDate   DateTime?
