{
  "installCommand": "npm install --prefix=../..",
  "buildCommand": "cd ../.. && if [ -n \"$DATABASE_URL\" ] && ! echo \"$DATABASE_URL\" | grep -qE 'localhost|127\\.0\\.0\\.1'; then npm run migrate:deploy -w @siteyonetim/db; else echo 'Skipping migrate (no remote DATABASE_URL)'; fi && npm run build -w @siteyonetim/web",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/due-accruals",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/accrual-reminders",
      "schedule": "0 8 2 * *"
    },
    {
      "path": "/api/cron/late-fees",
      "schedule": "0 7 5 * *"
    },
    {
      "path": "/api/cron/report-exports",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/auditor-quarter-reminders",
      "schedule": "0 9 7 1,4,7,10 *"
    },
    {
      "path": "/api/cron/bank-statement-sync",
      "schedule": "0 7 * * *"
    }
  ]
}
